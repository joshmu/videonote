{
  "name": "videonote",
  "version": "0.1.0",
  "keywords": [
    "josh mu",
    "nextjs",
    "react",
    "todo",
    "video",
    "videonote"
  ],
  "license": "MIT",
  "author": {
    "name": "josh mu",
    "email": "hello@videonote.app",
    "url": "https://joshmu.dev"
  },
  "scripts": {
    "dev": "DYNAMODB_ENDPOINT=http://localhost:8000 DYNAMODB_TABLE=videonote-local next dev",
    "dev:aws": "DYNAMODB_TABLE=videonote-dev AWS_REGION=ap-southeast-2 next dev",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "docker stop videonote-dynamodb",
    "db:seed": "node scripts/db-seed.mjs",
    "build": "next build",
    "start": "next start",
    "prod": "next build && next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "next build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "infra:install": "pnpm --dir infra install --frozen-lockfile",
    "infra:test": "pnpm --dir infra test",
    "infra:synth": "pnpm --dir infra cdk:synth",
    "infra:diff": "pnpm --dir infra cdk:diff",
    "infra:deploy:dev": "pnpm --dir infra cdk:deploy VideonoteDev",
    "infra:deploy:prod": "pnpm --dir infra cdk:deploy VideonoteProd",
    "plop": "plop",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@sentry/nextjs": "11.9.0",
    "@vercel/oidc-aws-credentials-provider": "3.3.15",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "motion": "^14.7.1",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "next-absolute-url": "^1.2.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-player": "^3.4.0",
    "react-scroll": "^1.9.3",
    "universal-cookie": "^8.1.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-scroll": "^1.8.10",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "plop": "^4.0.5",
    "postcss": "^8.5.30",
    "postcss-preset-env": "^11.5.2",
    "sass": "^1.105.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-debug-screens": "^3.0.1",
    "testcontainers": "12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
