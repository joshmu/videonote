MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.ffkbo.mongodb.net/<db_name>?retryWrites=true&w=majority
MONGODB_DB=<db_name>
SMTP_USER=<email>
SMTP_PASS=<password>
JWT_TOKEN_SECRET=<jtw_token_secret>

# Data backend: mongo (default) or dynamodb
DATA_BACKEND=
# DynamoDB table (videonote-local with `pnpm db:up`; Vercel sets videonote-dev / videonote-prod)
DYNAMODB_TABLE=
# DynamoDB Local endpoint for development (http://localhost:8000); unset for AWS
DYNAMODB_ENDPOINT=
# AWS region of the table (ap-southeast-2)
AWS_REGION=
# Set on Vercel only: the IAM role the functions assume through Vercel OIDC
AWS_ROLE_ARN=
