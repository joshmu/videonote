# Signs session and Share tokens: require('crypto').randomBytes(64).toString('hex')
JWT_TOKEN_SECRET=

# DynamoDB table. `pnpm dev` uses videonote-local on DynamoDB Local (`pnpm db:up`);
# Vercel sets videonote-dev (Preview, Development) and videonote-prod (Production).
DYNAMODB_TABLE=
# DynamoDB Local endpoint for development (http://localhost:8000); unset for AWS
DYNAMODB_ENDPOINT=
# AWS region of the table (ap-southeast-2)
AWS_REGION=
# Set on Vercel only: the IAM role the functions assume through Vercel OIDC
AWS_ROLE_ARN=
